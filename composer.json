{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mateusjunges/coding-style",
    "description": "Opinionated coding style tooling for Laravel applications",
    "keywords": [
        "laravel",
        "coding-style",
        "pint",
        "rector",
        "phpstan",
        "larastan"
    ],
    "homepage": "https://github.com/mateusjunges/coding-style",
    "license": "MIT",
    "authors": [
        {
            "name": "Mateus Junges",
            "email": "mateus@junges.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/filesystem": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "rector/rector": "^2.4"
    },
    "require-dev": {
        "brianium/paratest": "<7.28",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0"
    },
    "autoload": {
        "psr-4": {
            "Junges\\CodingStyle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Junges\\CodingStyle\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "rector": [
            "vendor/bin/rector process --ansi"
        ],
        "rector:check": [
            "vendor/bin/rector process --dry-run --ansi"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=-1"
        ],
        "cs": [
            "@rector",
            "@lint",
            "@analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@rector:check",
            "@test:types",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Junges\\CodingStyle\\CodingStyleServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
